APP_NAME=GigaCorp Customer Support RAG Agent
APP_VERSION=2.0.0

# --- Vector Store ---
VECTOR_STORE_TYPE=faiss              # faiss | chromadb
VECTOR_STORE_PATH=data/vector_store

# --- Embeddings ---
EMBEDDING_PROVIDER=huggingface       # huggingface | openai
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2     # fastembed model name

# --- LLM ---
LLM_PROVIDER=                        # openai | ollama (leave blank for rule-based)
LLM_MODEL=gpt-4o-mini                # or: gpt-4o, llama3.1:8b
OPENAI_API_KEY=

# --- Memory ---
MEMORY_BACKEND=langgraph_state       # langgraph_state | json_file

# --- RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.45
MEMORY_MAX_TURNS=20
SESSION_TIMEOUT_MINUTES=60

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true
