APP_NAME=GigaCorp Customer Support RAG Agent
APP_VERSION=2.0.0

# --- Security ---
# API_KEY=change-me-to-a-secure-random-string

# --- Vector Store ---
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=data/vector_store

# --- Embeddings ---
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Memory ---
MEMORY_BACKEND=langgraph_state

# --- RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.28
MEMORY_MAX_TURNS=20
SESSION_TIMEOUT_MINUTES=60
MAX_HISTORY_TOKENS=2048
SUMMARIZATION_THRESHOLD_TURNS=20

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- Database (PostgreSQL) ---
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gigacorp
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# --- JWT ---
# JWT_SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
