APP_NAME=GigaCorp Enterprise Customer Support Platform
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# API_KEY=change-me-to-a-secure-random-string

# --- Vector Store ---
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=data/vector_store

# --- Embeddings ---
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Memory ---
MEMORY_BACKEND=langgraph_state

# --- RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.28
MEMORY_MAX_TURNS=20
SESSION_TIMEOUT_MINUTES=60
MAX_HISTORY_TOKENS=2048
SUMMARIZATION_THRESHOLD_TURNS=20

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gigacorp
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# ENTERPRISE FEATURES
# =============================================================================

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_RATE_LIMIT_DB=2
REDIS_JOB_DB=3
REDIS_SOCKET_TIMEOUT=5

# --- Caching ---
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_EMBEDDING_TTL_SECONDS=3600
CACHE_RESPONSE_TTL_SECONDS=600
CACHE_MAX_SIZE=5000

# --- Rate Limiting ---
RATE_LIMITING_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_HOUR=500
RATE_LIMIT_INGEST_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_NAME=GigaCorp Support
EMAIL_FROM_ADDRESS=support@gigacorp.com
EMAIL_ENABLED=false

# --- Notifications ---
NOTIFICATION_ENABLED=true
NOTIFICATION_WS_PING_INTERVAL=30
NOTIFICATION_WS_PING_TIMEOUT=10

# --- File Storage ---
FILE_STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip

# --- Background Jobs ---
JOB_QUEUE_URL=redis://localhost:6379/3
JOB_CONCURRENCY=4
JOB_MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/gigacorp.log
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_BACKUP_COUNT=10
SENTRY_DSN=

# --- Monitoring ---
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL_SECONDS=30

# --- Audit ---
AUDIT_ENABLED=true
AUDIT_LOG_TABLE=audit_logs
AUDIT_LOG_BODY_MAX_LENGTH=10000
